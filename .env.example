# RELIC — environment variables
#
# Copy this file to .env and fill in values for LLM baselines.
# The .env file is listed in .gitignore and MUST NOT be committed.
#
# Required only for Baseline C (llm_only) and Baseline D (dep_llm):
#   GROQ_API_KEY  — primary; used with llama-3.3-70b-versatile via Groq
#   OPENAI_API_KEY — optional; only if routing to the OpenAI endpoint directly
#
# Never include the actual key value here or in any tracked file.

# Primary LLM provider (Groq) — required for LLM baselines
GROQ_API_KEY=

# Optional: OpenAI endpoint (only if not using Groq)
OPENAI_API_KEY=

# Optional: Anthropic (not used in Paper 1 evaluation)
ANTHROPIC_API_KEY=

# Optional: override provider/model routing for OpenAI-compatible clients
OPENAI_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: override GnuCOBOL binary paths (defaults use PATH lookup)
# COBC=/usr/bin/cobc
# COBRUN=/usr/bin/cobcrun
