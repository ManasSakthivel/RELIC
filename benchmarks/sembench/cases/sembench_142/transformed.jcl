//SYSUT1   DD DSN=WAREHOUSE.INVENTORY.TEMP,DISP=SHR
//SYSUT2   DD DSN=WAREHOUSE.INVENTORY.FINAL,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(50,20)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
