//CATMAN07 JOB (ACCT707,'ADMIN'),'IDCAMS CLUSTER OPS',
//         CLASS=S,MSGCLASS=X
//IDC1     EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE CORP.VSAM.KSDS CLUSTER PURGE
  SET MAXCC = 0
  DEFINE CLUSTER (NAME(CORP.VSAM.KSDS) -
         INDEXED -
         KEYS(16 0) -
         RECORDSIZE(200 200) -
         CYLINDERS(20 5))
/*
//IDC2     EXEC PGM=IDCAMS,COND=(0,NE,IDC1)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  REPRO -
    INDATASET(CORP.FLAT.SEED) -
    OUTDATASET(CORP.VSAM.KSDS)
/*
//IDC3     EXEC PGM=IDCAMS,COND=(4,LT,IDC2),COND=(0,LE)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  PRINT -
    INDATASET(CORP.VSAM.KSDS) -
    CHARACTER -
    COUNT(50)
/*
